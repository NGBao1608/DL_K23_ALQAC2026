# Copy this file to .env for local runs and fill in secrets locally.
# On Kaggle, use Add-ons > Secrets. On Colab, use Colab Secrets.

# Official ALQAC team credential. Never commit the real value.
ALQAC_TEAM_TOKEN=

# Official Case Content Retrieval API
ALQAC_API_BASE_RETRIEVE=https://alqac-api.ngrok.pro

# Data paths, relative to the repository root
CORPUS_PATH=data/raw/corpus_law_pub.json
PUBLIC_TEST_PATH=data/raw/ALQAC2026_public_test.json

# Local organizer-provided Private Test input. This path is git-ignored.
PRIVATE_TEST_PATH=data/raw/ALQAC_private_test.json

# Optional Hugging Face cache location for local/Kaggle/Colab runs
HF_HOME=.cache/huggingface
